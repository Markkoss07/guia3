#include <iostream>
using namespace std;

/*Hacer un programa para mostrar por pantalla los números del 1 al 20 salteando
de a 3 valores. Es decir: 1, 4, 7, 10, 13, 16, 19.
Importante: El programa no tiene ningún ingreso de datos.
Nota: probarlo con For y con While.
*/

int main(){
int num = 1;

///Del 1 al 20 con FOR.
for (int i = 1; i <= 20; i = i + 3){
    cout << i << endl;
}
cout << endl;
///Del 1 al 20 con While.
while(num <= 20){
    cout << num << endl;
    num = num + 3;
}

return 0;
}
