Ejemplo A: 2, 10, 20, 8, 25, 13, 36, - 8, -5, 20 se informa máximo: 36.
Ejemplo B: 5, -13, 23, 81, -55, -13, 55, 4, 15, -20 Se informa máximo: 4.
Ejemplo C: -5, -13, -20, -8, -55, -13, -55, -14, -15, -20 se informa máximo: -8.
*/

int main(){
int num, maximo = 0;
    bool hayPar = false;

    for (int i = 1; i <= 10; i++) {
        cout << "Ingresar un numero: ";
        cin >> num;

        if (num % 2 == 0) {
            if (hayPar == false || num > maximo) {
                maximo = num;
                hayPar = true;
            }
        }
    }

    if (hayPar) {
        cout << "Maximo: " << maximo << endl;
    } else {
        cout << "No se ingresaron numeros pares" << endl;
    }


